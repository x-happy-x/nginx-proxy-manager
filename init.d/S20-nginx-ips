#!/bin/sh
# Explicit proxy aliases only; never infer addresses or restart network services.
set -eu
case "${1:-start}" in stop|status) exit 0;; esac
APP_DIR="${HOME_NET_APP_DIR:-/opt/etc/homenet/nginx}"
[ ! -f "$APP_DIR/config/runtime.env" ] || . "$APP_DIR/config/runtime.env"
for entry in ${PROXY_INTERFACE_IPS:-}; do
  dev="${entry%%=*}"
  cidr="${entry#*=}"
  case "$dev:$cidr" in br0:192.168.1.2/24|br2:192.168.99.2/24) ;; *) echo "Unexpected alias: $entry; configure it explicitly outside HomeNet" >&2; exit 1;; esac
  if ! ip -o -4 addr show dev "$dev" | grep -F " $cidr " >/dev/null; then
    ip addr add "$cidr" dev "$dev"
  fi
done
# Firmware TLS SNI filter exemption for these aliases; ndm re-applies it after netfilter rebuilds.
hook="/opt/etc/ndm/netfilter.d/60-homenet-tls-sni.sh"
[ ! -x "$hook" ] || type=iptables table=mangle HOME_NET_APP_DIR="$APP_DIR" "$hook"
