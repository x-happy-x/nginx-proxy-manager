#!/bin/sh

### BEGIN INIT INFO
# Provides:          nginx-manager-lite
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Nginx Manager Lite
### END INIT INFO

SCRIPT_PATH="${0}"
while [ -L "$SCRIPT_PATH" ]; do
  LINK_TARGET="$(readlink "$SCRIPT_PATH")"
  case "$LINK_TARGET" in
    /*) SCRIPT_PATH="$LINK_TARGET" ;;
    *) SCRIPT_PATH="$(dirname "$SCRIPT_PATH")/$LINK_TARGET" ;;
  esac
done
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
APP_DIR_DEFAULT="/opt/etc/homenet/nginx"
APP_DIR_CANDIDATE="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
if [ -x "$APP_DIR_CANDIDATE/bin/linux-arm64/manager" ] || [ -f "$APP_DIR_CANDIDATE/config/runtime.env" ]; then
  APP_DIR="$APP_DIR_CANDIDATE"
else
  APP_DIR="$APP_DIR_DEFAULT"
fi
GO_MANAGER="$APP_DIR/bin/linux-arm64/manager"
ENV_FILE="$APP_DIR/config/runtime.env"
ROUTES_PATH="$APP_DIR/routes.yml"
GEN_ROUTES_PATH="$APP_DIR/bin/linux-arm64/nginx"
HOST="0.0.0.0"
PORT="8080"
PID_FILE="/opt/var/run/nginx-manager-lite.pid"
LOG_FILE="/opt/var/log/nginx-manager-lite.log"
NGINX_CONF_ROOT="/opt/etc/homenet/proxy"
NGINX_LISTEN_IPS=""
NGINX_TEST_CMD=""
NGINX_RELOAD_CMD=""
LE_ROOT="/opt/etc/letsencrypt"
LOCAL_CA_CERT="/opt/etc/nginx/local-ca/ca.crt"
LOCAL_CA_KEY="/opt/etc/nginx/local-ca/ca.key"

if [ -f "$ENV_FILE" ]; then
  # shellcheck disable=SC1090
  set -a
  . "$ENV_FILE"
  set +a
  APP_DIR="${HOME_NET_APP_DIR:-$APP_DIR}"
  HOST="${LITE_UI_HOST:-$HOST}"
  PORT="${LITE_UI_PORT:-$PORT}"
  PID_FILE="${HOME_NET_UI_PID:-$PID_FILE}"
  LOG_FILE="${HOME_NET_UI_LOG:-$LOG_FILE}"
fi

# The installer (NPM-40) puts binaries in bin/linux-<arch> and names the folder here.
BIN_DIR="${HOME_NET_BIN_DIR:-$APP_DIR/bin/linux-arm64}"
GO_MANAGER="$BIN_DIR/manager"
ENV_FILE="$APP_DIR/config/runtime.env"
ROUTES_PATH="${ROUTES_PATH:-$APP_DIR/routes.yml}"
GEN_ROUTES_PATH="${GEN_ROUTES_PATH:-$BIN_DIR/nginx}"

running_pid() {
  if [ ! -f "$PID_FILE" ]; then
    return 1
  fi
  PID="$(cat "$PID_FILE" 2>/dev/null)"
  case "$PID" in
    ''|*[!0-9]*)
      return 1
      ;;
  esac
  if [ -r "/proc/$PID/cmdline" ] && tr '\000' ' ' < "/proc/$PID/cmdline" | grep -F "$GO_MANAGER" >/dev/null && kill -0 "$PID" 2>/dev/null; then
    printf '%s\n' "$PID"
    return 0
  fi
  return 1
}

wait_for_stop() {
  PID="$1"
  COUNT=0
  while kill -0 "$PID" 2>/dev/null; do
    COUNT=$((COUNT + 1))
    if [ "$COUNT" -ge 30 ]; then
      return 1
    fi
    sleep 1
  done
  return 0
}

start() {
  [ -d "/opt/var/run" ] || mkdir -p /opt/var/run
  [ -d "/opt/var/log" ] || mkdir -p /opt/var/log
  cd "$APP_DIR" || exit 1
  if PID="$(running_pid)"; then
    echo "nginx-manager-lite already running"
    return 0
  fi
  rm -f "$PID_FILE"
  ROUTES_PATH="$ROUTES_PATH" \
  GEN_ROUTES_PATH="$GEN_ROUTES_PATH" \
  LITE_UI_HOST="$HOST" \
  LITE_UI_PORT="$PORT" \
  NGINX_CONF_ROOT="$NGINX_CONF_ROOT" \
  NGINX_LISTEN_IPS="$NGINX_LISTEN_IPS" \
  NGINX_TEST_CMD="$NGINX_TEST_CMD" \
  NGINX_RELOAD_CMD="$NGINX_RELOAD_CMD" \
  LE_ROOT="$LE_ROOT" \
  LOCAL_CA_CERT="$LOCAL_CA_CERT" \
  LOCAL_CA_KEY="$LOCAL_CA_KEY" \
  nohup "$GO_MANAGER" >>"$LOG_FILE" 2>&1 &
  PID=$!
  sleep 1
  if ! kill -0 "$PID" 2>/dev/null; then
    rm -f "$PID_FILE"
    echo "failed to start nginx-manager-lite" >&2
    return 1
  fi
  echo "$PID" > "$PID_FILE"
  echo "nginx-manager-lite started"
}

stop() {
  if ! PID="$(running_pid)"; then
    rm -f "$PID_FILE"
    echo "nginx-manager-lite not running"
    return 0
  fi
  kill "$PID" 2>/dev/null || true
  if ! wait_for_stop "$PID"; then
    kill -9 "$PID" 2>/dev/null || true
    sleep 1
    if kill -0 "$PID" 2>/dev/null; then
      echo "failed to stop nginx-manager-lite" >&2
      return 1
    fi
  fi
  rm -f "$PID_FILE"
  echo "nginx-manager-lite stopped"
}

restart() {
  stop || return 1
  start
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart) restart ;;
  *) echo "Usage: $0 {start|stop|restart}" ;;
esac
