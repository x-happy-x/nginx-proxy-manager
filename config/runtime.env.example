# HomeNet runtime settings for a new router. install.sh fills the @...@ values
# from its questions and keeps this file on updates. config/runtime.env is the
# one of this repository's own router.

# Paths
ROUTES_PATH=/opt/etc/homenet/nginx/routes.yml
HOME_NET_BIN_DIR=@BIN_DIR@
GEN_ROUTES_PATH=@BIN_DIR@/nginx
NGINX_CONF_ROOT=/opt/etc/homenet/proxy
STATIC_ROOT=frontend/static
REACT_INDEX_REL=react/index.html
ROUTE_ACCESS_LOG=/opt/var/log/homenet/route_access.log
LOCAL_CA_CERT=/opt/etc/nginx/local-ca/ca.crt
LOCAL_CA_KEY=/opt/etc/nginx/local-ca/ca.key
LE_ROOT=/opt/etc/letsencrypt
NDMC_BIN=ndmc
IP_HOST_DELETE_MODE=no-host

# Addresses the dedicated proxy listens on, and the aliases S20-nginx-ips adds
# for them (device=address/mask). Only these aliases skip the firmware TLS filter.
NGINX_LISTEN_IPS=@LISTEN_IPS@
PROXY_INTERFACE_IPS="@ALIASES@"

# Console
LITE_UI_HOST=@UI_HOST@
LITE_UI_PORT=@UI_PORT@
UI_RESTART_CMD="/opt/etc/init.d/S99nginx-manager-lite restart"
HOME_NET_INITD_DIR=/opt/etc/init.d
HOME_NET_UI_LOG=/opt/var/log/nginx-manager-lite.log
HOME_NET_UI_PID=/opt/var/run/nginx-manager-lite.pid

# Dedicated proxy only: never signal the firmware nginx
NGINX_BINARY=/usr/sbin/nginx
NGINX_MAIN_CONF=/opt/etc/homenet/proxy/nginx.conf
NGINX_PID=/opt/etc/homenet/proxy/nginx.pid
NGINX_ACCESS_LOG=/opt/var/log/homenet/access.log
NGINX_ERROR_LOG=/opt/var/log/homenet/error.log
PROXY_LOG_MAX_MB=16

# Mihomo (XKeen): DNS records go to the system hosts, the core is not reloaded
MIHOMO_DNS_MODE=system-hosts
MIHOMO_CONFIG=/opt/etc/mihomo/config.yaml
MIHOMO_HOSTS_PATH=/etc/hosts
MIHOMO_SOCKS=127.0.0.1:7891
NETWORK_STATE_DIR=/opt/etc/homenet/network

# Optional: Proxmox and MikroTik for the «Сеть» section (see config/runtime.env)
# PROXMOX_URL=https://192.168.x.x:8006
# PROXMOX_TOKEN_FILE=/opt/etc/homenet/secrets/proxmox.token
# MIKROTIK_CREDENTIALS_FILE=/opt/etc/homenet/secrets/mikrotik.env

# Account gateway guard (docs/account-gateway.md): 1 needs a configured gateway
HOMENET_ACCESS_ENABLED=@ACCESS@
