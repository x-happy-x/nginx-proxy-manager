# Common runtime paths
ROUTES_PATH=/opt/etc/homenet/nginx/routes.yml
GEN_ROUTES_PATH=/opt/etc/homenet/nginx/bin/linux-arm64/nginx
NGINX_CONF_ROOT=/opt/etc/homenet/proxy
STATIC_ROOT=frontend/static
REACT_INDEX_REL=react/index.html
NGINX_LISTEN_IPS=192.168.1.2,192.168.99.2
ROUTE_ACCESS_LOG=/opt/var/log/homenet/route_access.log
LOCAL_CA_CERT=/opt/etc/nginx/local-ca/ca.crt
LOCAL_CA_KEY=/opt/etc/nginx/local-ca/ca.key
LE_ROOT=/opt/etc/letsencrypt
NDMC_BIN=ndmc
IP_HOST_DELETE_MODE=no-host

# UI
LITE_UI_HOST=192.168.1.1
LITE_UI_PORT=63412
UI_RESTART_CMD="/opt/etc/init.d/S99nginx-manager-lite restart"
DMS_ROOT=/opt/dms
DMS_SERVICE_BIN=/opt/bin/dms-service

# Init/CLI
HOME_NET_INITD_DIR=/opt/etc/init.d
HOME_NET_UI_LOG=/opt/var/log/nginx-manager-lite.log
HOME_NET_UI_PID=/opt/var/run/nginx-manager-lite.pid

# Dedicated proxy only: never signal the firmware nginx
NGINX_BINARY=/usr/sbin/nginx
NGINX_MAIN_CONF=/opt/etc/homenet/proxy/nginx.conf
NGINX_PID=/opt/etc/homenet/proxy/nginx.pid
NGINX_ACCESS_LOG=/opt/var/log/homenet/access.log
NGINX_ERROR_LOG=/opt/var/log/homenet/error.log
PROXY_LOG_MAX_MB=16
PROXY_INTERFACE_IPS="br0=192.168.1.2/24 br2=192.168.99.2/24"

# No Mihomo reload, only dynamic system hosts
MIHOMO_DNS_MODE=system-hosts
MIHOMO_CONFIG=/opt/etc/mihomo/config.yaml
MIHOMO_HOSTS_PATH=/etc/hosts
