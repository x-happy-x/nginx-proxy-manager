# Deploy target
ROUTER_HOST=192.168.1.1
ROUTER_USER=root
ROUTER_PORT=222

# Password auth (requires sshpass installed locally)
ROUTER_PASSWORD=keenetic

# Remote project path on router
REMOTE_DIR=/opt/etc/homenet/nginx

# Optional SSH options
SSH_OPTS='-o StrictHostKeyChecking=accept-new'

# Deploy behavior
RESTART_UI=1
RESTART_CMD='/opt/bin/homenet restart'
UPLOAD_APP_ICONS=1

# 0 = npm install/ci before build, 1 = skip install
SKIP_INSTALL=0
